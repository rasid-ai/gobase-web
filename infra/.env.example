# Host environment for the VPS deploy path. Copy to `.env` beside
# docker-compose.prod.yml on each server and fill in real values there.
# Secrets are named here, never valued (CLAUDE.md). CI never writes this file.

# --- images ---------------------------------------------------------------
# GitHub org or user that owns the GHCR packages; the image names are built
# from it. IMAGE_TAG is exported by CI (the commit SHA); set it by hand only
# to roll back to a specific build.
GHCR_OWNER=
# IMAGE_TAG=latest

# --- ports (bound to 127.0.0.1; host nginx is the only client) -------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- deploy gate ----------------------------------------------------------
# The real public URL. Checked through nginx on purpose, so a green deploy
# means TLS, routing and the app all work — not just that a process started.
HEALTH_CHECK_URL=https://portal.example/api/health/

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=portal.example
# Admin is served in production (docs/adr/007) and posts forms over TLS, so
# Django needs the origin it will be reached on.
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example

# --- databases (native on the host, reached over the Docker gateway) -------
PORTAL_DB_NAME=portal
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_HOST=host.docker.internal
PORTAL_DB_PORT=5432

# `kb` is READ-ONLY (docs/adr/002): these credentials must belong to a role
# with no write grants. Unused until the Map/Ask slices.
KB_DB_NAME=kb
KB_DB_USER=
KB_DB_PASSWORD=
KB_DB_HOST=host.docker.internal
KB_DB_PORT=5432

# --- first bring-up without TLS -------------------------------------------
# Only for a host reached over http by IP, before a certificate exists. A
# browser will not store a Secure cookie over http, so sign-in fails silently
# with these left at their defaults. Both send cookies in clear text: set them
# only while nothing real is behind the login, and delete these lines — along
# with REFRESH_COOKIE_SECURE=false — as soon as TLS is up.
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false

# --- sessions -------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_COOKIE_NAME=gp_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax

# --- dagster ---------------------------------------------------------------
# The pipeline orchestrator, read over its GraphQL API only (docs/adr/004).
# It has no authentication and binds to loopback on its own host, so the
# backend container reaches it through the host gateway. Confirm the two
# names against the server before first use — context/integrations/dagster.md
# has the query that prints them.
DAGSTER_GRAPHQL_URL=http://host.docker.internal:3000/graphql
DAGSTER_REPOSITORY_LOCATION=gobase_orchestration.definitions
DAGSTER_REPOSITORY=__repository__
DAGSTER_JOB_NAME=weekly_pipeline
DAGSTER_TIMEOUT_SECONDS=5

# The geocoder — turns typed addresses into coordinates (docs/adr/011). See
# context/integrations/esri.md. A blank key is meaningful, not missing: address
# search answers 503 and the pages say it is unavailable, so the portal runs
# without an ArcGIS account. Sign-up is free; the not-stored tier gives 20,000
# geocodes a month before it costs anything.
ESRI_GEOCODE_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer
ESRI_API_KEY=
ESRI_TIMEOUT_SECONDS=5
ESRI_MAX_CANDIDATES=5

# --- the lake (S3-compatible object storage) -------------------------------
# The silver bucket the Map reads GeoParquet from. Nothing in code names a
# provider: RustFS and AWS S3 differ only in these values, so moving between
# them is an edit here and a restart.
#
# RustFS: endpoint host:port, path-style URLs, region us-east-1.
# AWS S3: endpoint blank, vhost URLs, TLS on, the bucket's real region. Leave
# both keys blank there to use the instance role via DuckDB's credential chain
# rather than storing static keys on the host.
LAKE_S3_ENDPOINT=
LAKE_S3_REGION=
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=
LAKE_S3_USE_SSL=
LAKE_S3_URL_STYLE=
# LAKE_PAGE_SIZE=10000
