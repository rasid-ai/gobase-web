  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "maplibre-gl": "6.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-map-gl": "8.1.3",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
