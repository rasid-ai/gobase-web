# Geo Portal backend — local development.
# Secrets are referred to by name; never commit real values (CLAUDE.md).

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-any-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# `portal` — this repo's database, read-write.
PORTAL_DB_NAME=portal
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432

# `kb` — the knowledge base, READ-ONLY (docs/adr/002). Unused until the
# Map/Ask slices; credentials must be a read-only role.
KB_DB_NAME=kb
KB_DB_USER=
KB_DB_PASSWORD=
KB_DB_HOST=localhost
KB_DB_PORT=5432

# Session lifetimes.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Refresh cookie. Secure must be true anywhere but local http.
REFRESH_COOKIE_NAME=gp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
