# Geo Portal backend — local development.
# Secrets are referred to by name; never commit real values (CLAUDE.md).

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-any-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# `portal` — this repo's database, read-write.
PORTAL_DB_NAME=portal
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432

# `kb` — the knowledge base, READ-ONLY (docs/adr/002). Unused until the
# Map/Ask slices; credentials must be a read-only role.
KB_DB_NAME=kb
KB_DB_USER=
KB_DB_PASSWORD=
KB_DB_HOST=localhost
KB_DB_PORT=5432

# Session lifetimes.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Refresh cookie. Secure must be true anywhere but local http.
REFRESH_COOKIE_NAME=gp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Dagster — the pipeline orchestrator, read over its GraphQL API only
# (docs/adr/004). See context/integrations/dagster.md. In Docker, Dagster
# runs on the host: use http://host.docker.internal:3000/graphql.
DAGSTER_GRAPHQL_URL=http://127.0.0.1:3000/graphql
DAGSTER_REPOSITORY_LOCATION=gobase_orchestration.definitions
DAGSTER_REPOSITORY=__repository__
DAGSTER_JOB_NAME=weekly_pipeline
DAGSTER_TIMEOUT_SECONDS=5

# The geocoder — turns typed addresses into coordinates (docs/adr/011). See
# context/integrations/esri.md. A blank key is meaningful, not missing: address
# search answers 503 and the pages say it is unavailable, so the portal runs
# without an ArcGIS account. Sign-up is free; the not-stored tier gives 20,000
# geocodes a month before it costs anything.
ESRI_GEOCODE_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer
ESRI_API_KEY=
ESRI_TIMEOUT_SECONDS=5
ESRI_MAX_CANDIDATES=5

# --- the lake (S3-compatible object storage) -------------------------------
# Where the GeoParquet lives that the Map draws. No provider is named in code:
# MinIO, RustFS and AWS S3 differ only in these values.
#
# Locally, the `minio` container: endpoint 127.0.0.1:9000, no TLS, path-style
# URLs. On AWS: leave the endpoint blank, set the bucket's real region, use
# vhost URLs and TLS. Leave both keys blank on AWS to use an instance role
# through DuckDB's credential chain instead of static keys.
LAKE_S3_ENDPOINT=127.0.0.1:9000
# Blank for MinIO and RustFS, which have no regions. AWS needs the bucket's.
LAKE_S3_REGION=
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=
LAKE_S3_USE_SSL=false
LAKE_S3_URL_STYLE=path
# The most features one asset may return. The read asks for one more than this
# to tell a full file from a truncated one.
LAKE_MAX_FEATURES=5000
