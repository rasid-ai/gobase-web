# Geo Portal backend — local development.
# Secrets are referred to by name; never commit real values (CLAUDE.md).

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-any-deploy
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# `portal` — this repo's database, read-write.
PORTAL_DB_NAME=portal
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_HOST=localhost
PORTAL_DB_PORT=5432

# `kb` — the knowledge base, READ-ONLY (docs/adr/002). Unused until the
# Map/Ask slices; credentials must be a read-only role.
KB_DB_NAME=kb
KB_DB_USER=
KB_DB_PASSWORD=
KB_DB_HOST=localhost
KB_DB_PORT=5432

# Session lifetimes.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Refresh cookie. Secure must be true anywhere but local http.
REFRESH_COOKIE_NAME=gp_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# Dagster — the pipeline orchestrator, read over its GraphQL API only
# (docs/adr/004). See context/integrations/dagster.md. In Docker, Dagster
# runs on the host: use http://host.docker.internal:3000/graphql.
DAGSTER_GRAPHQL_URL=http://127.0.0.1:3000/graphql
DAGSTER_REPOSITORY_LOCATION=gobase_orchestration.definitions
DAGSTER_REPOSITORY=__repository__
DAGSTER_JOB_NAME=weekly_pipeline
DAGSTER_TIMEOUT_SECONDS=5

# The geocoder — turns typed addresses into coordinates (docs/adr/011). See
# context/integrations/esri.md. A blank key is meaningful, not missing: address
# search answers 503 and the pages say it is unavailable, so the portal runs
# without an ArcGIS account. Sign-up is free; the not-stored tier gives 20,000
# geocodes a month before it costs anything.
ESRI_GEOCODE_URL=https://geocode-api.arcgis.com/arcgis/rest/services/World/GeocodeServer
ESRI_API_KEY=
ESRI_TIMEOUT_SECONDS=5
ESRI_MAX_CANDIDATES=5

# GoDoc's RAG server — embeds the map's Semantic question with the model that
# embedded the catalog's cards (docs/adr/018, context/integrations/godoc.md).
# Locally it is `godoc serve-rag` on 8003, started by hand. A blank URL is
# meaningful, not missing: semantic search answers 503 and the map says it is
# unavailable, so the portal runs without the service.
GODOC_URL=http://127.0.0.1:8003
GODOC_TIMEOUT_SECONDS=10

# The Ask agent — gobase-agent, a separate service deployed alone, which runs
# the model and the tools (docs/adr/023, context/integrations/agent.md). This
# backend is its only caller. A blank URL is meaningful, not missing: every
# chat endpoint answers 503 and the map says Ask is unavailable.
# AGENT_SERVICE_TOKEN is what the agent requires; set the same value there.
AGENT_URL=
AGENT_SERVICE_TOKEN=
AGENT_TIMEOUT_SECONDS=10
AGENT_STREAM_TIMEOUT_SECONDS=120

# --- the lake (S3-compatible object storage) -------------------------------
# Where the GeoParquet lives that the Map draws. No provider is named in code:
# MinIO, RustFS and AWS S3 differ only in these values.
#
# Locally, the `minio` container: endpoint 127.0.0.1:9000, no TLS, path-style
# URLs. On AWS: leave the endpoint blank, set the bucket's real region, use
# vhost URLs and TLS. Leave both keys blank on AWS to use an instance role
# through DuckDB's credential chain instead of static keys.
LAKE_S3_ENDPOINT=127.0.0.1:9000
# Blank for MinIO and RustFS, which have no regions. AWS needs the bucket's.
LAKE_S3_REGION=
LAKE_S3_ACCESS_KEY=
LAKE_S3_SECRET_KEY=
LAKE_S3_USE_SSL=false
LAKE_S3_URL_STYLE=path
# The most features in one page of an asset's features. The read asks for one
# more than this to tell a full page from the last one. Callers page through
# the rest, so this caps a response, not an asset.
LAKE_PAGE_SIZE=10000

# --- rasters for desktop clients (docs/adr/022) ------------------------------
# Short-lived credentials that read one raster, for the ArcGIS Pro add-in.
# Blank means off: the endpoint answers 503. Locally the lake is reached
# where the portal reaches it; context/integrations/lake-sts.md sets up the
# issuing user.
LAKE_PUBLIC_ENDPOINT=
LAKE_STS_ACCESS_KEY=
LAKE_STS_SECRET_KEY=
LAKE_STS_DURATION_SECONDS=3600
LAKE_STS_TIMEOUT_SECONDS=5

# --- raster figures and clips (docs/adr/029) ---------------------------------
# The portal reads a raster's pixels itself for raster-stats and clip.tif,
# with the LAKE_S3_* settings above (context/integrations/raster.md).
# The most pixels read for raster-stats; a larger place is read at reduced
# size and the answer says it is approximate.
RASTER_STATS_MAX_PIXELS=4000000
# The largest clip.tif, in bytes of pixels before compression (width x height
# x bands x bytes per value); a larger place is a 400. 64 MB.
RASTER_CLIP_MAX_BYTES=67108864
# The longest one raster read may take, in seconds, from opening the raster
# to its last pixel; a read that reaches it answers 503. A clip at the cap
# pulls 45 to 70 MB from the lake, depending on the window, so 60 asks for a
# link of 6 to 9 Mbit/s to it. Raise it for a slower link. 0 means no limit.
RASTER_READ_TIMEOUT_SECONDS=60
